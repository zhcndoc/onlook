FROM oven/bun:1.3.1 AS bun

FROM node:24-bookworm AS builder

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

ENV CI=true

COPY . .

RUN bun install --filter @onlook/docs

WORKDIR /app/docs

RUN bun run build

FROM node:24-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=8080

COPY --from=builder /app/docs/.next/standalone ./

COPY --from=builder /app/docs/.next/static ./docs/.next/static

COPY --from=builder /app/docs/public ./docs/public

EXPOSE 8080

CMD ["node", "docs/server.js"]
